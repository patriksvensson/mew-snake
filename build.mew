#load "game/engine/build/native.mew"

use engine.build;
use std.build;
use std.cli;
use std.io;
use std.process;
use system.runtime.interopservices;

pub type Game {
    pub field debug: bool;
    pub field lint: bool;
}

setup(args: string[]) -> Game {
    let cli = Cli::new(args);
    return new Game { debug: cli.flag("--debug"), lint: cli.flag("--lint") };
}

impl Engine for Game {
    pub fn folder() -> string {
        return "game/engine";
    }

    pub fn program() -> string {
        return "game/.mew";
    }

    pub fn optimize() -> bool {
        return !self.debug;
    }
}

task format(ctx: Game)
    in sources = glob("game/**/*.mew", "build.mew")
    when ctx.lint
{
    shell("mew", "fmt", "--check", ".")?;
}

task game : native, format
    in sources = glob("game/**/*.mew")
    out program = file("game/.mew/main.dll")
    out engine = file("game/.mew/engine.dll")
{
    shell("mew", "compile", "game/main.mew")?;
}

task play : game {
    shell("dotnet", game.program.path)?;
}

task platform -> string {
    return RuntimeInformation::RuntimeIdentifier;
}

task package : native, game, platform
    out archive = file($".artifacts/mew-snake-{platform}.zip")
{
    compress(directory("game/.mew"), archive)?;
}

task default : game { }
