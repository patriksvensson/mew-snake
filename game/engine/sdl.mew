#load "color.mew"
#load "geometry.mew"

namespace engine;

use std.collections;
use system;

[ffi("SDL3")]
static external fn SDL_Init(flags: u32) -> bool;

[ffi("SDL3")]
static external fn SDL_Quit() -> void;

[ffi("SDL3")]
static external fn SDL_SetHint(name: string, value: string) -> bool;

[ffi("SDL3")]
static external fn SDL_GL_SetAttribute(attribute: i32, value: i32) -> bool;

[ffi("SDL3")]
static external fn SDL_CreateWindow(title: string, width: i32, height: i32, flags: u64) -> i64;

[ffi("SDL3")]
static external fn SDL_DestroyWindow(window: i64) -> void;

[ffi("SDL3")]
static external fn SDL_GL_CreateContext(window: i64) -> i64;

[ffi("SDL3")]
static external fn SDL_GL_DestroyContext(context: i64) -> bool;

[ffi("SDL3")]
static external fn SDL_GL_SetSwapInterval(interval: i32) -> bool;

[ffi("SDL3")]
static external fn SDL_GL_SwapWindow(window: i64) -> bool;

[ffi("SDL3")]
static external fn SDL_SetWindowFullscreen(window: i64, fullscreen: bool) -> bool;

[ffi("SDL3")]
static external fn SDL_RaiseWindow(window: i64) -> bool;

[ffi("SDL3")]
static external fn SDL_ShowCursor() -> bool;

[ffi("SDL3")]
static external fn SDL_HideCursor() -> bool;

[ffi("SDL3")]
static external fn SDL_GetWindowSizeInPixels(window: i64, width: i32[], height: i32[]) -> bool;

[ffi("SDL3")]
static external fn SDL_PollEvent(event: u8[]) -> bool;

[ffi("SDL3")]
static external fn SDL_GetTicks() -> u64;

[ffi("SDL3")]
static external fn SDL_OpenGamepad(id: u32) -> i64;

[ffi("SDL3")]
static external fn SDL_GetGamepadFromID(id: u32) -> i64;

[ffi("SDL3")]
static external fn SDL_CloseGamepad(gamepad: i64) -> void;

[ffi("SDL3")]
static external fn SDL_HasGamepad() -> bool;

[ffi("SDL3")]
static external fn SDL_GetGamepadButtonLabel(gamepad: i64, button: i32) -> i32;

[ffi("SDL3")]
static external fn SDL_SetGamepadLED(gamepad: i64, red: u8, green: u8, blue: u8) -> bool;

[ffi("SDL3")]
static external fn SDL_RumbleGamepad(gamepad: i64, low: u16, high: u16, milliseconds: u32) -> bool;

pub union Key {
    up,
    down,
    left,
    right,
    w,
    a,
    s,
    d,
    e,
    f,
    p,
    space,
    enter,
    escape,
    other,
}

impl Key {
    pub static fn from_scancode(scancode: u32) -> Key {
        return match scancode {
            82 => .up,
            81 => .down,
            80 => .left,
            79 => .right,
            26 => .w,
            4 => .a,
            22 => .s,
            7 => .d,
            8 => .e,
            9 => .f,
            19 => .p,
            44 => .space,
            40 => .enter,
            41 => .escape,
            _ => .other,
        };
    }
}

pub union Button {
    up,
    down,
    left,
    right,
    south,
    east,
    start,
    other,
}

impl Button {
    pub static fn from_index(index: u8) -> Button {
        return match index {
            0 => .south,
            1 => .east,
            6 => .start,
            11 => .up,
            12 => .down,
            13 => .left,
            14 => .right,
            _ => .other,
        };
    }
}

pub union Axis {
    left_x,
    left_y,
    other,
}

impl Axis {
    pub static fn from_index(index: u8) -> Axis {
        return match index {
            0 => .left_x,
            1 => .left_y,
            _ => .other,
        };
    }
}

pub union Event {
    quit,
    focus_lost,
    entered_fullscreen,
    left_fullscreen,
    key(Key),
    gamepad_added(u32),
    gamepad_removed(u32),
    button(Button),
    axis(u32, Axis, i32),
    other,
}

impl Event {
    pub static fn decode(bytes: u8[]) -> Event {
        let quit: u32 = 0x100;
        let focus_lost: u32 = 0x20F;
        let entered_fullscreen: u32 = 0x217;
        let left_fullscreen: u32 = 0x218;
        let key_down: u32 = 0x300;
        let axis_motion: u32 = 0x650;
        let button_down: u32 = 0x651;
        let gamepad_added: u32 = 0x653;
        let gamepad_removed: u32 = 0x654;

        let kind = BitConverter::ToUInt32(bytes, 0);
        if kind == quit {
            return .quit;
        }

        if kind == focus_lost {
            return .focus_lost;
        }

        if kind == entered_fullscreen {
            return .entered_fullscreen;
        }

        if kind == left_fullscreen {
            return .left_fullscreen;
        }

        let repeated = bytes[37] != 0;
        if kind == key_down && !repeated {
            return .key(Key::from_scancode(BitConverter::ToUInt32(bytes, 24)));
        }

        let gamepad = BitConverter::ToUInt32(bytes, 16);
        if kind == gamepad_added {
            return .gamepad_added(gamepad);
        }

        if kind == gamepad_removed {
            return .gamepad_removed(gamepad);
        }

        if kind == button_down {
            return .button(Button::from_index(bytes[20]));
        }

        if kind == axis_motion {
            return .axis(gamepad, Axis::from_index(bytes[20]), BitConverter::ToInt16(bytes, 24));
        }

        return .other;
    }
}

pub type Clock {
    mut field last: u64;

    pub static fn start() -> Clock {
        return new Clock { last: SDL_GetTicks() };
    }

    pub fn tick(limit: f64 = 250.0) -> f64 {
        let now = SDL_GetTicks();
        let elapsed = (now - self.last) as f64;
        self.last = now;
        return Math::Min(elapsed, limit);
    }
}

pub type Window {
    field handle: i64;
    field context: i64;
    field event: u8[];
    field pixel_width: i32[];
    field pixel_height: i32[];
    pub field size: Size;
    pub field samples: i32;
    mut field gamepads: List<u32>;

    pub static fn open(title: string, size: Size, samples: i32 = 4, fullscreen: bool = false) -> Result<Window, string> {
        // On macOS, full screen without a space of its own goes in at once, so
        // the picture is never stretched on the way.
        SDL_SetHint("SDL_VIDEO_MAC_FULLSCREEN_SPACES", "0");
        let video: u32 = 0x20;
        if !SDL_Init(video) {
            return .err("SDL could not start its video subsystem.");
        }

        // Gamepads are optional, so a failure here is ignored.
        let gamepad: u32 = 0x2000;
        SDL_Init(gamepad);

        let depth_size = 6;
        let stencil_size = 7;
        let multisample_buffers = 13;
        let multisample_samples = 14;
        let context_major_version = 17;
        let context_minor_version = 18;
        let context_flags = 19;
        let context_profile_mask = 20;
        let forward_compatible = 2;
        let core_profile = 1;
        SDL_GL_SetAttribute(context_major_version, 4);
        SDL_GL_SetAttribute(context_minor_version, 1);
        SDL_GL_SetAttribute(context_profile_mask, core_profile);
        SDL_GL_SetAttribute(context_flags, forward_compatible);
        SDL_GL_SetAttribute(depth_size, 24);
        SDL_GL_SetAttribute(stencil_size, 8);
        SDL_GL_SetAttribute(multisample_buffers, 1);
        SDL_GL_SetAttribute(multisample_samples, samples);

        let opengl: u64 = 0x2;
        let high_pixel_density: u64 = 0x2000;
        let handle = SDL_CreateWindow(title, size.width, size.height, opengl + high_pixel_density);
        if handle == 0 {
            SDL_Quit();
            return .err("SDL could not open a window.");
        }

        let context = SDL_GL_CreateContext(handle);
        if context == 0 {
            SDL_DestroyWindow(handle);
            SDL_Quit();
            return .err("SDL could not create an OpenGL context.");
        }

        SDL_GL_SetSwapInterval(1);

        // Going full screen after the window opens makes SDL report it, as it
        // does for later changes. On macOS the window can lose its focus on the
        // way into its own space, so it is raised before and after.
        if fullscreen {
            SDL_RaiseWindow(handle);
            SDL_SetWindowFullscreen(handle, true);
        }

        return .ok(new Window {
            handle: handle,
            context: context,
            event: new u8[128],
            pixel_width: new i32[1],
            pixel_height: new i32[1],
            size: size,
            samples: samples,
            gamepads: List<u32>::new(),
        });
    }

    pub fn poll() -> Option<Event> {
        if !SDL_PollEvent(self.event) {
            return .none;
        }

        // SDL only reports buttons and sticks for gamepads that have been
        // opened.
        let event = Event::decode(self.event);
        match event {
            .gamepad_added(gamepad) => {
                SDL_OpenGamepad(gamepad);
                self.gamepads.add(gamepad);
            },
            .gamepad_removed(gamepad) => {
                SDL_CloseGamepad(SDL_GetGamepadFromID(gamepad));
                let remaining = List<u32>::new();
                for other in self.gamepads {
                    if other != gamepad {
                        remaining.add(other);
                    }
                }

                self.gamepads = remaining;
            },
            .entered_fullscreen => {
                SDL_HideCursor();
                SDL_RaiseWindow(self.handle);
            },
            .left_fullscreen => {
                SDL_ShowCursor();
            },
            _ => { },
        }

        return .some(event);
    }

    pub fn set_fullscreen(on: bool) {
        SDL_SetWindowFullscreen(self.handle, on);
    }

    pub fn has_gamepad() -> bool {
        return SDL_HasGamepad();
    }

    pub fn label(button: i32) -> i32 {
        if self.gamepads.count() == 0 {
            return 0;
        }

        return SDL_GetGamepadButtonLabel(SDL_GetGamepadFromID(self.gamepads.get(0)), button);
    }

    // Both motors take a strength from nothing to one, the low one heavy and
    // the high one buzzy.
    pub fn rumble(low: f32, high: f32, milliseconds: u32) {
        let full: f32 = 65535.0;
        for gamepad in self.gamepads {
            SDL_RumbleGamepad(SDL_GetGamepadFromID(gamepad), (low.clamp_to_unit() * full) as u16, (high.clamp_to_unit() * full) as u16, milliseconds);
        }
    }

    // Only gamepads with a light bar, like the DualSense, show the colour.
    pub fn light(color: Color) {
        for gamepad in self.gamepads {
            SDL_SetGamepadLED(SDL_GetGamepadFromID(gamepad), color.r, color.g, color.b);
        }
    }

    pub fn pixels() -> Size {
        SDL_GetWindowSizeInPixels(self.handle, self.pixel_width, self.pixel_height);
        return new Size { width: self.pixel_width[0], height: self.pixel_height[0] };
    }

    pub fn present() {
        SDL_GL_SwapWindow(self.handle);
    }

    pub fn close() {
        SDL_GL_DestroyContext(self.context);
        SDL_DestroyWindow(self.handle);
        SDL_Quit();
    }
}
