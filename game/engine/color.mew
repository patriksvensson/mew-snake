namespace engine;

use system;

[struct]
pub type Color {
    pub field r: u8;
    pub field g: u8;
    pub field b: u8;
    pub field a: u8 = 255;

    pub static fn rgb(r: u8, g: u8, b: u8) -> Color {
        return new Color { r: r, g: g, b: b };
    }

    // Hue goes from 0 to 1 and wraps around.
    pub static fn hsv(hue: f32, saturation: f32, value: f32) -> Color {
        let turn = (hue - Math::Floor(hue)) * 6.0;
        let sector = Math::Floor(turn) as i32;
        let along = (turn - sector) as f32;
        let low = value * (1.0 - saturation);
        let falling = value * (1.0 - saturation * along);
        let rising = value * (1.0 - saturation * (1.0 - along));
        return match sector {
            0 => unit(value, rising, low),
            1 => unit(falling, value, low),
            2 => unit(low, value, rising),
            3 => unit(low, falling, value),
            4 => unit(rising, low, value),
            _ => unit(value, low, falling),
        };
    }

    static fn unit(r: f32, g: f32, b: f32) -> Color {
        return new Color { r: (r.clamp_to_unit() * 255.0) as u8, g: (g.clamp_to_unit() * 255.0) as u8, b: (b.clamp_to_unit() * 255.0) as u8 };
    }

    pub fn same(other: Color) -> bool {
        return self.r == other.r && self.g == other.g && self.b == other.b && self.a == other.a;
    }

    pub fn fade(amount: f32) -> Color {
        return new Color { r: self.r, g: self.g, b: self.b, a: self.a.scale(amount) };
    }

    pub fn mix(other: Color, amount: f32) -> Color {
        return new Color {
            r: self.r.blend(other.r, amount),
            g: self.g.blend(other.g, amount),
            b: self.b.blend(other.b, amount),
            a: self.a.blend(other.a, amount),
        };
    }
}

impl u8 {
    pub fn to_unit() -> f32 {
        return self / 255.0;
    }

    pub fn scale(amount: f32) -> u8 {
        return (self * amount.clamp_to_unit()) as u8;
    }

    pub fn blend(target: u8, amount: f32) -> u8 {
        return (self + (target - self) * amount.clamp_to_unit()) as u8;
    }
}

impl f32 {
    pub fn clamp_to_unit() -> f32 {
        return Math::Clamp(self, 0.0, 1.0);
    }
}
