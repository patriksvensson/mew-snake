#load "sdl.mew"

namespace engine;

use std.collections;
use system;

// What a game does around its screens each frame: it reads its input into
// them, keeps its own time, and draws them between a beginning and an end.
pub interface Host<T> {
    fn read(screens: Screens<T>);
    fn update(milliseconds: f64);
    fn begin(milliseconds: f64);
    fn end();
}

pub interface Screen<T> {
    fn handle(command: T) -> Transition<T>;
    fn update(milliseconds: f64) -> Transition<T>;
    fn draw();
}

impl Screen<T> {
    // A transparent screen lets the one below it keep moving and show through.
    pub fn is_transparent() -> bool {
        return false;
    }

    pub fn enter() { }

    pub fn leave() { }
}

pub union Transition<T> {
    stay,
    push(Screen<T>),
    pop,
    swap(Screen<T>),
    reset(Screen<T>),
    quit,
}

pub type Screens<T> {
    field stack: List<Screen<T>>;
    mut field depth: i32;

    pub static fn new(first: Screen<T>) -> Screens<T> {
        let screens = new Screens<T> { stack: List<Screen<T>>::new(), depth: 0 };
        screens.push(first);
        return screens;
    }

    pub fn is_empty() -> bool {
        return self.depth == 0;
    }

    pub fn handle(command: T) {
        if !self.is_empty() {
            self.apply(self.top().handle(command));
        }
    }

    pub fn update(milliseconds: f64) {
        if self.is_empty() {
            return;
        }

        // The screens below the top only move on, since changing the stack is
        // up to the top one.
        for at in self.base()..self.depth - 1 {
            self.stack.get(at).update(milliseconds);
        }

        self.apply(self.top().update(milliseconds));
    }

    pub fn draw() {
        for at in self.base()..self.depth {
            self.stack.get(at).draw();
        }
    }

    // Runs until the last screen closes.
    pub fn run(host: Host<T>) {
        let clock = Clock::start();
        while !self.is_empty() {
            host.read(self);
            let elapsed = clock.tick();
            self.update(elapsed);
            host.update(elapsed);
            host.begin(elapsed);
            self.draw();
            host.end();
        }
    }

    fn top() -> Screen<T> {
        return self.stack.get(self.depth - 1);
    }

    fn base() -> i32 {
        let mut base = Math::Max(0, self.depth - 1);
        while base > 0 && self.stack.get(base).is_transparent() {
            base -= 1;
        }

        return base;
    }

    fn apply(transition: Transition<T>) {
        match transition {
            .stay => { },
            .push(screen) => {
                self.push(screen);
            },
            .pop => {
                self.pop();
            },
            .swap(screen) => {
                self.pop();
                self.push(screen);
            },
            .reset(screen) => {
                self.clear();
                self.push(screen);
            },
            .quit => {
                self.clear();
            },
        }
    }

    fn push(screen: Screen<T>) {
        // The list never shrinks, so places above the top are reused.
        if self.depth < self.stack.count() {
            self.stack.set(self.depth, screen);
        } else {
            self.stack.add(screen);
        }

        self.depth += 1;
        screen.enter();
    }

    fn pop() {
        self.top().leave();
        self.depth -= 1;
    }

    fn clear() {
        while !self.is_empty() {
            self.pop();
        }
    }
}
