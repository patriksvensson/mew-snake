#load "engine/screens.mew"
#load "engine/sdl.mew"
#load "engine/sokol.mew"
#load "high_scores.mew"
#load "input.mew"
#load "viewport.mew"
#load "scene.mew"
#load "screens/title.mew"
#load "snake.mew"
#load "stage.mew"

use engine;

let board = new Board { };
let viewport = new Viewport { board: board };
let opened = Window::open("Mew Snake", viewport.size);
if let .err(reason) = opened {
    eprintln(reason);
    return 1;
}

let window = opened.unwrap();
let painter = Painter::new(window);
let scene = Scene::new(painter, viewport);
let input = Input::new(window);
let stage = Stage::new(board, scene, input, HighScores::load());
let screens = Screens<Command>::new(TitleScreen::new(stage));
let clock = Clock::start();

while !screens.is_empty() {
    for command in input {
        screens.handle(command);
    }

    let elapsed = clock.tick();
    screens.update(elapsed);

    scene.begin(elapsed);
    screens.draw();
    scene.end();
}

painter.shutdown();
window.close();
