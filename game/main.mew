#reference "local:./engine"
#load "controls/input.mew"
#load "saves/settings.mew"
#load "scene/scene.mew"
#load "scene/viewport.mew"
#load "screens/title.mew"
#load "sound/sounds.mew"
#load "stage.mew"
#load "world/board.mew"

use engine;

let board = new Board { };
let viewport = new Viewport { board: board };
let settings = Settings::load();
let opened = App::open("Mew Snake", viewport.size, settings.is_fullscreen());
if let .err(reason) = opened {
    eprintln(reason);
    return 1;
}

let app = opened.unwrap();
let input = Input::new(app.window);
let scene = Scene::new(app.painter, viewport, input);
let sounds = Sounds::open();
let stage = Stage::new(board, scene, input, sounds, settings);
Screens<Command>::new(TitleScreen::new(stage)).run(stage);
sounds.close();
app.close();
