#load "../controls/input.mew"
#load "../controls/light_bar.mew"
#load "../saves/high_scores.mew"
#load "../world/game.mew"
#load "../world/season.mew"
#load "palette.mew"
#load "shower.mew"
#load "speech.mew"
#load "trail.mew"
#load "viewport.mew"
#load "weather.mew"

use engine;
use std.collections;
use system;

[struct]
type Ripple {
    pub field at: Point;
    pub field time: f64;
}

pub type Scene {
    pub field painter: Painter;
    pub field viewport: Viewport;
    pub field palette: Palette;
    pub field ui: Ui;
    field input: Input;
    field light: LightBar;
    field sparks: Sparks;
    field trails: Trails;
    field weather: Weather;
    field shower: Shower;
    field speech: Speech;
    field ripples: Ring<Ripple>;
    field popups: Popups;
    field combos: Color[];
    mut field clock: f64;
    mut field shake: f32;

    pub field center: f32 {
        get { return self.viewport.width / 2; }
    }

    pub field middle: f32 {
        get { return self.viewport.top + self.viewport.grid_height / 2; }
    }

    pub static fn new(painter: Painter, viewport: Viewport, input: Input) -> Scene {
        let palette = Palette::new();
        return new Scene {
            painter: painter,
            viewport: viewport,
            palette: palette,
            ui: Ui::new(painter, palette.shadow),
            input: input,
            light: LightBar::new(input, palette),
            sparks: Sparks::new(512),
            trails: Trails::new(96),
            weather: Weather::new(viewport, 46),
            shower: Shower::new(viewport),
            speech: Speech::new(),
            ripples: Ring<Ripple>::new(4),
            popups: Popups::new(8),
            combos: new Color[] { palette.accent, palette.orange, palette.food, palette.grape },
            clock: 0.0,
            shake: 0.0,
        };
    }

    // Effects keep moving under every screen, even when the game below one is
    // paused.
    pub fn begin(milliseconds: f64) {
        self.clock += milliseconds;
        self.ui.update(milliseconds);
        self.popups.update(milliseconds);
        self.shake = Math::Max(0.0, self.shake - milliseconds / 450.0) as f32;
        self.sparks.update(milliseconds);
        self.trails.update(milliseconds);
        self.weather.update(milliseconds);
        self.shower.update(milliseconds, self.weather.season());

        self.painter.begin(self.palette.background);
    }

    pub fn wear_trail(trail: Trail) {
        self.trails.wear(trail);
    }

    // Returns true once for each clap of thunder in a passing shower.
    pub fn thundered() -> bool {
        return self.shower.thundered();
    }

    pub fn clock() -> f64 {
        return self.clock;
    }

    pub fn shake() -> f32 {
        return self.shake;
    }

    pub fn end() {
        self.painter.end();
        self.light.show(self.clock);
    }

    pub fn react(game: Game) {
        self.light.react(game, self.clock);
        if !game.demo {
            self.speech.hear(game, self.clock);
        }

        for moment in game.moments {
            match moment {
                .ate(bite) => {
                    let fruit = bite.fruit;
                    let center = self.viewport.center(bite.cell);
                    self.sparks.burst(center, fruit.color(self.palette), count: 28 * fruit.points(), speed: 220.0);
                    self.sparks.burst(center, self.palette.shine, count: 12, speed: 140.0);
                    self.ripples.keep(new Ripple { at: center, time: self.clock });
                    if !game.demo {
                        self.pop_up(bite, center);
                    }
                },
                .frenzy_began => {
                    let at = new Point { x: self.center, y: self.middle };
                    for color in new Color[] { self.palette.food, self.palette.orange, self.palette.gold, self.palette.leaf, self.palette.grape } {
                        self.sparks.burst(at, color, count: 24, speed: 320.0);
                    }

                    self.popups.add(at, "FRUIT FRENZY!", self.palette.accent, life: 1600.0);
                },
                .vanished(cell) => {
                    self.sparks.burst(self.viewport.center(cell), self.palette.dim, count: 10, speed: 70.0);
                },
                .warped(from, to) => {
                    self.sparks.burst(self.viewport.center(from), self.palette.portal_in, count: 18, speed: 150.0);
                    self.sparks.burst(self.viewport.center(to), self.palette.portal_out, count: 18, speed: 150.0);
                },
                .powered(cell, power) => {
                    let center = self.viewport.center(cell);
                    self.sparks.burst(center, power.color(), count: 32, speed: 200.0);
                    self.popups.add(center, $"{power.name()}!", power.color());
                },
                .faded(cell) => {
                    self.sparks.burst(self.viewport.center(cell), self.palette.gold, count: 18, speed: 90.0);
                },
                .appeared(cell, animal) => {
                    let center = self.viewport.center(cell);
                    self.sparks.burst(center, animal.color(), count: 16, speed: 90.0);
                    self.popups.add(center, animal.call(), animal.color());
                },
                .caught(cell, animal, points) => {
                    let center = self.viewport.center(cell);
                    self.sparks.burst(center, animal.color(), count: 40, speed: 220.0);
                    self.sparks.burst(center, self.palette.eye, count: 20, speed: 150.0);
                    self.ripples.keep(new Ripple { at: center, time: self.clock });
                    self.popups.add(center, $"+{points}", self.palette.accent);
                    self.popups.add(center.offset(0.0, -28.0), "GOT IT!", animal.color());
                },
                .escaped(cell) => {
                    self.sparks.burst(self.viewport.center(cell), self.palette.dim, count: 12, speed: 70.0);
                },
                .season_turned(season) => {
                    self.popups.add(new Point { x: self.center, y: self.viewport.top + 70.0 }, season.name(), season.tint());
                },
                .crashed(cell) => {
                    self.sparks.burst(self.viewport.center(cell), self.palette.crash, count: 40, speed: 260.0);
                    self.shake = 1.0;
                },
            }
        }
    }

    pub fn pop(game: Game, index: i32) {
        let snake = game.snake;
        let center = self.viewport.center(snake.segment(index));
        let mut count = 14;
        if index == 0 {
            count = 28;
        }

        self.sparks.burst(center, snake.color(self, game, index), count: count, speed: 170.0);
        self.sparks.burst(center, self.palette.crash, count: count / 2, speed: 120.0);
        self.shake = Math::Max(self.shake, 0.3f32);
        self.light.pop(self.clock);
    }

    pub fn draw_game(game: Game, gone: i32 = 0) {
        self.light.follow(game, self.clock);
        self.light.lighten(self.shower.flash());
        self.weather.follow(game.season());
        let shake = self.shake * self.shake * 9.0;
        let dx = (Math::Sin(self.clock * 0.09) * shake) as f32;
        let dy = (Math::Cos(self.clock * 0.11) * shake) as f32;

        self.painter.shift(dx, dy);
        self.draw_board();
        self.shower.draw_behind(self.painter);
        self.weather.draw(self.painter);
        self.draw_ripples();
        game.level.draw(self.painter, self.palette, self.viewport, self.clock);
        self.draw_food(game);
        for treat in game.treats() {
            treat.fruit.draw(self.painter, self.palette, self.viewport.center(treat.cell), self.viewport.cell, self.clock, 1.0);
        }

        if let .some(item) = game.power_up() {
            item.power.draw(self.painter, self.palette, self.viewport.center(item.cell), self.viewport.cell, self.clock, item.left);
        }

        game.critter.draw(self.painter, self.palette, self.viewport, self.clock);

        self.follow_trail(game);
        self.trails.draw(self.painter);
        self.draw_snake(game, gone, dx, dy);
        self.sparks.draw(self.painter);
        self.shower.draw_front(self.painter);
        self.painter.unshift();

        // A score that floats over a menu would only get in the way.
        if !game.is_over() && !game.is_paused() {
            self.popups.draw(self.ui, self.viewport.margin, self.viewport.margin + self.viewport.grid_width);
        }

        if !game.demo && !game.is_paused() {
            self.speech.draw(self.painter, self.palette, self.viewport, game.snake.head_point(self, game), self.clock);
        }
    }

    pub fn draw_hud(game: Game, best: i32) {
        self.draw_powers(game);
        self.draw_score(game);
        self.draw_best(best, game.is_easy());
    }

    // The legend sits in the lower right corner of the board.
    pub fn draw_legend(accept: string, back: string) {
        let viewport = self.viewport;
        self.ui.draw_legend(viewport.margin + viewport.grid_width - 18.0, viewport.bottom - 34.0, self.input.button(.accept), accept, self.input.button(.back), back, self.palette.text);
    }

    pub fn draw_hint(prompt: Prompt, words: string, x: f32, y: f32) {
        self.ui.draw_hint(self.input.button(prompt), words, x, y, self.palette.text);
    }

    pub fn hint_width(prompt: Prompt, words: string) -> f32 {
        return self.ui.hint_width(self.input.button(prompt), words);
    }

    pub fn draw_score(game: Game) {
        let text = $"SCORE {game.score()}";
        self.ui.shadowed(.medium, self.viewport.margin, 24.0, text, self.palette.text);
        if game.combo() > 1 {
            let x = self.viewport.margin + self.painter.measure(.medium, $"{text} ");
            self.ui.shadowed(.medium, x, 24.0, $"X{game.combo()}", self.combo_color(game.combo()).fade(0.3 + game.combo_left() * 0.7));
        }
    }

    pub fn draw_best(best: i32, easy: bool) {
        let text = $"BEST {best}";
        let left = self.viewport.width - self.viewport.margin - self.painter.measure(.medium, text);
        self.ui.shadowed(.medium, left, 24.0, text, self.palette.dim);
        if easy {
            self.draw_easy(left - self.painter.measure(.medium, "EASY  "));
        }
    }

    pub fn draw_powers(game: Game) {
        let mut any = game.frenzy_left() > 0.0;
        for power in Power::all() {
            any = any || game.power_left(power) > 0.0;
        }

        if !any {
            return;
        }

        let texts = List<string>::new();
        let colors = List<Color>::new();
        if game.frenzy_left() > 0.0 {
            texts.add($"FRENZY {seconds(game.frenzy_left())}");
            colors.add(self.palette.food);
        }

        for power in Power::all() {
            if game.power_left(power) > 0.0 {
                texts.add($"{power.name()} {seconds(game.power_left(power))}");
                colors.add(power.color());
            }
        }

        let gap = "  ";
        let mut x = self.center - self.painter.measure(.small, string::join(gap, texts)) / 2;
        for at in 0..texts.count() {
            self.ui.shadowed(.small, x, 56.0, texts.get(at), colors.get(at));
            x += self.painter.measure(.small, texts.get(at) + gap);
        }
    }

    fn draw_easy(x: f32) {
        self.ui.shadowed(.medium, x, 24.0, "EASY", self.palette.leaf);
    }

    pub fn draw_table(scores: HighScores, top: f32, highlight: Option<i32>) {
        for at in 0..scores.limit {
            let rank = $"{at + 1}.";
            let mut initials = "---";
            let mut points = "-";
            let mut color = self.palette.dim;
            if at < scores.count {
                let entry = scores.entry(at);
                initials = entry.initials;
                points = $"{entry.score}";
                color = self.palette.text;
            }

            if let .some(index) = highlight {
                if index == at {
                    color = self.palette.accent;
                }
            }

            self.ui.shadowed_centered(.small, self.center, top + at * 24, $"{rank.pad_left(3)}  {initials}  {points.pad_left(4)}", color);
        }
    }

    pub fn shade(color: Color) {
        let viewport = self.viewport;
        self.painter.rect(viewport.margin, viewport.top, viewport.grid_width, viewport.grid_height, color);
    }

    pub fn draw_choice(y: f32, label: string, picked: bool) {
        self.ui.draw_choice(self.center, y, label, picked, self.palette.dim, self.palette.accent);
    }

    // A choice of skin, with the skin's name in its own colours.
    pub fn draw_skin_choice(y: f32, label: string, skin: Skin, picked: bool) {
        let width = self.painter.measure(.medium, label + skin.name());
        let left = self.center - width / 2;
        let mut color = self.palette.dim;
        if picked {
            self.ui.draw_arrows(self.center, y, width, self.palette.accent.fade(self.ui.pulse));
            color = self.palette.accent;
        }

        self.ui.shadowed(.medium, left, y, label, color);
        self.shadowed_skin(.medium, left + self.painter.measure(.medium, label), y, skin);
    }

    pub fn shadowed_skin(size: TextSize, left: f32, y: f32, skin: Skin) {
        let letters = skin.name().chars();
        let width = 8 * size.scale();
        for at in 0..letters.count {
            self.ui.shadowed(size, left + at * width, y, $"{letters[at]}", skin.color(self.palette, at, letters.count, self.clock));
        }
    }

    fn draw_board() {
        let viewport = self.viewport;
        self.painter.rect(viewport.margin - 5.0, viewport.top - 5.0, viewport.grid_width + 10.0, viewport.grid_height + 10.0, self.palette.frame);
        self.painter.checker(viewport.margin, viewport.top, viewport.board.columns, viewport.board.rows, viewport.cell, self.weather.tint(self.palette.tile), self.weather.tint(self.palette.tile_alternate));
    }

    fn draw_ripples() {
        let life = 1100.0;
        while !self.ripples.is_empty() && self.clock - self.ripples.first().time > life {
            self.ripples.pop_front();
        }

        let viewport = self.viewport;
        let board = viewport.board;
        for index in 0..self.ripples.count() {
            let ripple = self.ripples.get(index);
            let age = self.clock - ripple.time;
            let reach = age * 0.6;
            let strength = (1.0 - age / life) as f32;
            for cell in 0..board.count() {
                let center = viewport.center(board.cell_at(cell));
                let dx = center.x - ripple.at.x;
                let dy = center.y - ripple.at.y;
                let distance = Math::Sqrt(dx * dx + dy * dy);
                let wave = (1.0 - Math::Abs(distance - reach) / (viewport.cell * 1.4)) as f32;
                if wave > 0.0 {
                    let size = viewport.cell - 4.0;
                    self.painter.rect(center.x - size / 2, center.y - size / 2, size, size, self.palette.shine.fade(wave * strength * 0.2));
                }
            }
        }
    }

    fn follow_trail(game: Game) {
        if game.is_over() || game.is_paused() {
            return;
        }

        let snake = game.snake;
        let tail = self.viewport.center(snake.tail());
        let from = self.viewport.center(snake.trail);
        let mut at = tail;
        if Math::Abs(tail.x - from.x) + Math::Abs(tail.y - from.y) < self.viewport.cell * 1.5f32 {
            at = from.lerp(tail, game.progress());
        }

        self.trails.follow(at, snake.color(self, game, snake.length));
    }

    fn draw_snake(game: Game, gone: i32, dx: f32, dy: f32) {
        // A snake on its way through a wall shows on both sides of it, and
        // nowhere past the board.
        let viewport = self.viewport;
        if game.is_easy() {
            self.painter.clip(viewport.margin + dx, viewport.top + dy, viewport.grid_width, viewport.grid_height);
        }

        game.snake.draw(self, game, gone);
        if game.is_easy() {
            self.painter.unclip();
        }
    }

    pub fn draw_snooze(at: Point) {
        Speech::draw_snooze(self.painter, self.palette, at, self.clock);
    }

    pub fn clear_popups() {
        self.popups.clear();
    }

    fn pop_up(bite: Bite, center: Point) {
        let mut color = self.palette.accent;
        if bite.fruit.is_golden() {
            color = self.palette.gold;
        }

        self.popups.add(center, $"+{bite.points}", color);
        if bite.combo > 1 {
            self.popups.add(center.offset(0.0, -28.0), $"X{bite.combo}!", self.combo_color(bite.combo));
        }
    }

    static fn seconds(milliseconds: f64) -> f64 {
        return Math::Ceiling(milliseconds / 1000.0);
    }

    fn combo_color(combo: i32) -> Color {
        return self.combos[Math::Min(combo, self.combos.count + 1) - 2];
    }

    fn draw_food(game: Game) {
        game.fruit().draw(self.painter, self.palette, self.viewport.center(game.food()), self.viewport.cell, self.clock, game.shine());
    }
}
