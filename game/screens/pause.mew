#load "../stage.mew"
#load "../world/game.mew"
#load "dissolve.mew"
#load "setting_menu.mew"
#load "title.mew"

use engine;
use std.collections;
use system;

union Choice {
    resume,
    title,
    setting(Setting),
}

pub type PauseScreen {
    field stage: Stage;
    field game: Game;
    field menu: SettingMenu;
    field choices: Choice[];
    mut field selected: i32;

    pub static fn new(stage: Stage, game: Game) -> PauseScreen {
        let choices = List<Choice>::new();
        choices.add(.resume);
        for setting in Setting::all() {
            choices.add(.setting(setting));
        }

        choices.add(.title);
        return new PauseScreen { stage: stage, game: game, menu: SettingMenu::new(stage), choices: choices.to_array(), selected: 0 };
    }

    fn select(step: i32) {
        let count = self.choices.count;
        self.selected = (self.selected + step + count) % count;
        self.stage.sounds.play(.tick);

        // The music only plays under the menu while its volume is being picked,
        // so it can be heard.
        if let .setting(.music) = self.choices[self.selected] {
            self.stage.sounds.play_music();
        } else {
            self.stage.sounds.stop_music();
        }
    }

    fn choose(choice: Choice) -> Transition<Command> {
        return match choice {
            .resume => self.resume(),
            .title => self.leave_for_title(),
            .setting(setting) => self.change(setting, 0),
        };
    }

    fn change(setting: Setting, step: i32) -> Transition<Command> {
        if step == 0 {
            self.menu.pick(setting, self.game.snake);
        } else {
            self.menu.change(setting, step, self.game.snake);
        }

        if let .easy = setting {
            self.game.set_easy(self.stage.settings.is_easy());
        }

        return .stay;
    }

    fn leave_for_title() -> Transition<Command> {
        return DissolveScreen::to(self.stage, TitleScreen::new(self.stage), .choose);
    }

    fn resume() -> Transition<Command> {
        self.stage.sounds.play(.resume);
        return .pop;
    }

    static fn group(choice: Choice) -> i32 {
        return match choice {
            .resume => 0,
            .setting(_) => 1,
            .title => 2,
        };
    }

    fn label(choice: Choice) -> string {
        return match choice {
            .resume => "RESUME",
            .title => "BACK TO TITLE",
            .setting(setting) => self.menu.label(setting),
        };
    }
}

impl Screen<Command> for PauseScreen {
    pub fn is_transparent() -> bool {
        return true;
    }

    // The game still shows through, and keeps being updated, so it has to be
    // told to hold still.
    pub fn enter() {
        self.game.pause();
        self.stage.sounds.play(.pause);
        self.stage.sounds.stop_music();
    }

    pub fn leave() {
        self.game.resume();
        self.stage.sounds.play_music();
    }

    pub fn handle(command: Command) -> Transition<Command> {
        match command {
            .steer(.up) => {
                self.select(-1);
            },
            .steer(.down) => {
                self.select(1);
            },
            .steer(direction) => {
                if let .setting(setting) = self.choices[self.selected] {
                    self.change(setting, direction.dx());
                }
            },
            .confirm | .play => {
                return self.choose(self.choices[self.selected]);
            },
            .pause | .back => {
                return self.resume();
            },
            .easy => {
                self.change(.easy, 1);
            },
            .quit => {
                return .quit;
            },
            .suspend => { },
        }

        return .stay;
    }

    pub fn update(milliseconds: f64) -> Transition<Command> {
        return .stay;
    }

    pub fn draw() {
        let scene = self.stage.scene;
        let top = scene.viewport.top;
        scene.shade(scene.palette.deep_shade);
        scene.ui.shadowed_centered(.large, scene.center, top + 40.0, "PAUSED", scene.palette.text);
        scene.draw_snooze(new Point { x: scene.center + scene.painter.measure(.large, "PAUSED") / 2 + 8.0, y: top + 52.0 });
        for at in 0..self.choices.count {
            let choice = self.choices[at];
            let y = scene.viewport.top + 106.0 + at * 30 + group(choice) * 20;
            if let .setting(setting) = choice {
                self.menu.draw(setting, y, at == self.selected);
            } else {
                scene.draw_choice(y, self.label(choice), at == self.selected);
            }
        }

        let mut accept = "ACCEPT";
        if let .setting(_) = self.choices[self.selected] {
            accept = "CHANGE";
        }

        scene.draw_legend(accept, "BACK");
    }
}
