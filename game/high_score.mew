use std.io;
use system;

pub type HighScore {
    field path: string;
    mut field score: i32;

    pub static fn load() -> HighScore {
        let path = $"{Environment::GetEnvironmentVariable("HOME")}/.mew-snake";
        return new HighScore { path: path, score: read(path).unwrap_or(0) };
    }

    pub fn submit(score: i32) -> bool {
        if score <= self.score {
            return false;
        }

        self.score = score;
        if let .err(problem) = write_text(file(self.path), $"{score}") {
            eprintln($"The high score could not be saved: {problem}");
        }

        return true;
    }

    static fn read(path: string) -> Result<i32, string> {
        if !exists(path) {
            return .ok(0);
        }

        let text = read_text(file(path))?;
        return text.trim_end().parse_i32().map_err(|problem| problem.describe());
    }
}

impl Display for HighScore {
    pub fn display() -> string {
        return $"{self.score}";
    }
}
