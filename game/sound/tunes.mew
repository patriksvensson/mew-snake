use engine;

pub type Tunes {
    // The tunes for spring, summer, autumn and winter, in that order.
    pub static fn seasons() -> Tune[] {
        let rest = -1;
        return new Tune[] {
            new Tune {
                roots: new i32[] { 45, 41, 48, 43 },
                chords: new i32[] { 69, 72, 76, 81, 69, 72, 77, 81, 67, 72, 76, 79, 67, 71, 74, 79 },
                bass: new i32[] { 0, rest, 12, rest, 0, rest, 12, rest, 0, rest, 12, rest, 0, rest, 7, rest },
                leads: new i32[] {
                    2, rest, 1, 0, 1, rest, 2, 3, 2, rest, 1, rest, 0, 1, 2, rest,
                    3, rest, 3, 2, 1, rest, 2, rest, 3, 2, 1, rest, 2, rest, 3, rest,
                },
                drums: new i32[] { 1, 0, 4, 0, 2, 0, 4, 0, 1, 0, 4, 0, 2, 0, 4, 0 },
                lead: .square,
                loudness: 0.035,
                hold: 0.9,
            },
            new Tune {
                roots: new i32[] { 50, 47, 43, 45 },
                chords: new i32[] { 74, 78, 81, 86, 71, 74, 78, 83, 71, 74, 79, 83, 73, 76, 81, 85 },
                bass: new i32[] { 0, rest, rest, 0, rest, rest, 7, rest, 0, rest, rest, 0, rest, 12, 7, rest },
                leads: new i32[] {
                    0, rest, 1, rest, 2, 1, rest, 3, rest, 2, rest, 1, 2, rest, 3, rest,
                    3, rest, 2, 3, rest, 2, 1, rest, 0, rest, 1, rest, 2, rest, rest, rest,
                },
                drums: new i32[] { 5, 0, 4, 0, 6, 0, 5, 0, 5, 0, 4, 0, 6, 0, 4, 0 },
                lead: .square,
                loudness: 0.042,
                hold: 0.6,
            },
            new Tune {
                roots: new i32[] { 50, 46, 43, 45 },
                chords: new i32[] { 69, 74, 77, 81, 70, 74, 77, 82, 67, 70, 74, 79, 69, 73, 76, 81 },
                bass: new i32[] { 0, rest, rest, rest, rest, rest, 7, rest, 0, rest, rest, rest, 12, rest, 7, rest },
                leads: new i32[] {
                    3, rest, rest, 2, rest, rest, 1, rest, 2, rest, rest, 1, rest, rest, 0, rest,
                    1, rest, rest, 2, rest, rest, 3, rest, 2, rest, 1, rest, 0, rest, rest, rest,
                },
                drums: new i32[] { 1, 0, 0, 0, 2, 0, 4, 0, 1, 0, 1, 0, 2, 0, 0, 4 },
                lead: .triangle,
                loudness: 0.06,
                hold: 1.8,
            },
            new Tune {
                roots: new i32[] { 52, 48, 43, 50 },
                chords: new i32[] { 79, 83, 88, 91, 76, 79, 84, 88, 79, 83, 86, 91, 78, 81, 86, 90 },
                bass: new i32[] { 0, rest, 7, rest, 12, rest, 7, rest, 0, rest, 7, rest, 12, rest, 7, rest },
                leads: new i32[] {
                    0, 1, 2, 3, 2, 1, rest, rest, 0, 1, 2, 3, 2, rest, 1, rest,
                    3, rest, 2, rest, 1, rest, 0, rest, 1, 2, 3, rest, 2, rest, rest, rest,
                },
                drums: new i32[] { 5, 4, 4, 4, 6, 4, 4, 4, 5, 4, 4, 4, 6, 4, 4, 4 },
                lead: .triangle,
                loudness: 0.05,
                hold: 1.0,
            },
        };
    }
}
