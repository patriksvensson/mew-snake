#load "autopilot.mew"
#load "pilot.mew"
#load "game_state.mew"
#load "snake.mew"

use std.collections;
use system;

pub union Moment {
    ate(Cell),
    crashed(Cell),
}

pub type Game {
    pub field board: Board;
    pub field moments: List<Moment>;
    pub field state: GameState;
    field player: Player;
    field pilot: Pilot;
    field demo: bool;
    pub mut field over: bool;
    pub mut field paused: bool;

    pub static fn play(board: Board, random: Random) -> Game {
        let player = Player::new();
        return new(board, random, player, player, demo: false);
    }

    pub static fn demo(board: Board, random: Random, autopilot: Autopilot) -> Game {
        return new(board, random, Player::new(), autopilot, demo: true);
    }

    static fn new(board: Board, random: Random, player: Player, pilot: Pilot, demo: bool) -> Game {
        return new Game {
            board: board,
            moments: List<Moment>::new(),
            state: GameState::new(board, random),
            player: player,
            pilot: pilot,
            demo: demo,
            over: false,
            paused: false,
        };
    }

    pub fn steer(direction: Direction) {
        if !self.redo_step(direction) {
            self.player.queue(direction, self.state.heading);
        }
    }

    pub fn update(milliseconds: f64) {
        self.moments.clear();
        if self.over || self.paused {
            return;
        }

        self.state.elapsed += milliseconds;
        while self.state.elapsed >= self.state.interval && !self.over {
            self.state.elapsed -= self.state.interval;
            self.step();
        }
    }

    fn step() {
        let state = self.state;
        let before = state.heading;
        state.heading = self.pilot.steer(state);
        let moved = self.move_head();
        state.redoable = moved && state.heading.same(before);
    }

    fn redo_step(direction: Direction) -> bool {
        let state = self.state;
        if !state.can_redo(direction) {
            return false;
        }

        state.snake.retreat();
        state.heading = direction;
        state.redoable = false;
        self.move_head();
        return true;
    }

    fn move_head() -> bool {
        let state = self.state;
        let next = state.snake.head().next(state.heading);
        if state.blocks(next) {
            self.crash();
            return false;
        }

        let growing = next.same(state.food);
        state.snake.advance(next, growing);
        if growing {
            self.eat();
        }

        return !growing;
    }

    fn eat() {
        let state = self.state;
        self.moments.add(.ate(state.food));
        if !self.demo {
            state.score += 1;
            state.interval = Math::Max(70.0, state.interval - 3.0);
        }

        if !state.place_food() {
            state.won = true;
            self.over = true;
        }
    }

    fn crash() {
        if !self.demo {
            self.moments.add(.crashed(self.state.snake.head()));
        }

        self.over = true;
    }
}
