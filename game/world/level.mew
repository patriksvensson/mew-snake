#load "../engine/color.mew"
#load "../engine/geometry.mew"
#load "../engine/sokol.mew"
#load "../scene/palette.mew"
#load "../scene/viewport.mew"
#load "board.mew"

use engine;
use system;

[struct]
pub type Area {
    pub field x: i32;
    pub field y: i32;
    pub field width: i32;
    pub field height: i32;

    pub static fn of(x: i32, y: i32, width: i32, height: i32) -> Area {
        return new Area { x: x, y: y, width: width, height: height };
    }
}

// Portals come in pairs, each taking the snake to the other.
type Layout {
    pub field walls: Area[];
    pub field portals: Cell[];
}

pub type Level {
    field board: Board;
    field walls: i32[];
    field layouts: Layout[];
    mut field portals: Cell[];
    mut field number: i32;
    mut field rising: f64;
    mut field waiting: bool;
    mut field changes: i32;

    pub static fn new(board: Board) -> Level {
        let layouts = new Layout[] {
            new Layout { walls: new Area[0], portals: new Cell[0] },
            new Layout {
                walls: new Area[] {
                    Area::of(3, 3, 4, 1), Area::of(3, 4, 1, 3), Area::of(21, 3, 4, 1), Area::of(24, 4, 1, 3),
                    Area::of(3, 14, 4, 1), Area::of(3, 11, 1, 3), Area::of(21, 14, 4, 1), Area::of(24, 11, 1, 3),
                },
                portals: new Cell[] { new Cell { x: 6, y: 9 }, new Cell { x: 21, y: 9 } },
            },
            new Layout {
                walls: new Area[] { Area::of(13, 4, 2, 4), Area::of(13, 10, 2, 4), Area::of(6, 8, 5, 2), Area::of(17, 8, 5, 2) },
                portals: new Cell[] { new Cell { x: 3, y: 3 }, new Cell { x: 24, y: 14 }, new Cell { x: 24, y: 3 }, new Cell { x: 3, y: 14 } },
            },
            new Layout {
                walls: new Area[] { Area::of(4, 5, 8, 1), Area::of(16, 5, 8, 1), Area::of(4, 12, 8, 1), Area::of(16, 12, 8, 1) },
                portals: new Cell[] { new Cell { x: 13, y: 1 }, new Cell { x: 14, y: 16 } },
            },
        };

        return new Level { board: board, walls: new i32[board.count()], layouts: layouts, portals: new Cell[0], number: 0, rising: 0.0, waiting: false, changes: 0 };
    }

    // The layouts and their portals never change, so they are shared.
    pub fn copy() -> Level {
        let walls = new i32[self.walls.count];
        for at in 0..walls.count {
            walls[at] = self.walls[at];
        }

        return new Level {
            board: self.board,
            walls: walls,
            layouts: self.layouts,
            portals: self.portals,
            number: self.number,
            rising: self.rising,
            waiting: self.waiting,
            changes: self.changes,
        };
    }

    // How many times the walls have changed, so a copy can tell whether it is
    // still the same as the level.
    pub fn changes() -> i32 {
        return self.changes;
    }

    pub fn number() -> i32 {
        return self.number;
    }

    // A new layout's walls rise for a moment first, so nobody runs into one
    // that was not there a second ago.
    pub fn build(number: i32, easy: bool) {
        self.number = number;
        self.changes += 1;
        for at in 0..self.walls.count {
            self.walls[at] = nothing();
        }

        let layout = self.layouts[number];
        if !easy {
            for wall in layout.walls {
                for x in wall.x..wall.x + wall.width {
                    for y in wall.y..wall.y + wall.height {
                        self.walls[self.board.index(new Cell { x: x, y: y })] = rising();
                    }
                }
            }
        }

        self.portals = layout.portals;
        self.rising = 2000.0;
        self.waiting = true;
    }

    pub fn update(milliseconds: f64, taken: fn(Cell) -> bool) {
        self.rising = Math::Max(0.0, self.rising - milliseconds);
        if self.rising > 0.0 || !self.waiting {
            return;
        }

        let mut waiting = false;
        for at in 0..self.walls.count {
            if self.walls[at] == rising() {
                if taken(self.board.cell_at(at)) {
                    waiting = true;
                } else {
                    self.walls[at] = standing();
                    self.changes += 1;
                }
            }
        }

        self.waiting = waiting;
    }

    // Off the board is not a wall, since the board's edges are checked on their
    // own.
    pub fn blocks(cell: Cell) -> bool {
        return self.board.contains(cell) && self.walls[self.board.index(cell)] == standing();
    }

    pub fn is_free(cell: Cell) -> bool {
        return self.walls[self.board.index(cell)] == nothing() && self.portal(cell).is_none();
    }

    pub fn portal(cell: Cell) -> Option<Cell> {
        for at in 0..self.portals.count {
            if self.portals[at].same(cell) {
                return .some(self.portals[at + 1 - at % 2 * 2]);
            }
        }

        return .none;
    }

    pub fn draw(painter: Painter, palette: Palette, viewport: Viewport, clock: f64) {
        let size = viewport.cell;
        for at in 0..self.walls.count {
            let wall = self.walls[at];
            if wall != nothing() {
                let corner = viewport.center(self.board.cell_at(at)).offset(-size / 2, -size / 2);
                let stone = palette.frame.mix(palette.text, 0.22);
                if wall == standing() {
                    painter.rect(corner.x, corner.y, size, size, stone);
                    painter.rect(corner.x, corner.y, size, 4.0, stone.mix(palette.text, 0.3));
                    painter.rect(corner.x, corner.y + size - 4.0, size, 4.0, stone.mix(palette.pupil, 0.4));
                } else {
                    let pulse = (0.55 + Math::Sin(clock * 0.012) * 0.2) as f32;
                    painter.rect(corner.x + 4.0, corner.y + 4.0, size - 8.0, size - 8.0, stone.fade(pulse));
                }
            }
        }

        let colors = new Color[] { palette.portal_in, palette.portal_out };
        for at in 0..self.portals.count {
            let center = viewport.center(self.portals[at]);
            let color = colors[at / 2];
            let spin = (clock * 0.0012) as f32;
            painter.circle(center, size * 0.42, palette.background);
            painter.arc(center, size * 0.38, 3.0, 0.35, color, from: spin);
            painter.arc(center, size * 0.38, 3.0, 0.35, color, from: spin + 0.5);
            painter.arc(center, size * 0.22, 2.0, 0.3, color.fade(0.7), from: -spin * 1.6);
            painter.arc(center, size * 0.22, 2.0, 0.3, color.fade(0.7), from: 0.5 - spin * 1.6);
        }
    }

    static fn nothing() -> i32 {
        return 0;
    }

    static fn rising() -> i32 {
        return 1;
    }

    static fn standing() -> i32 {
        return 2;
    }
}
